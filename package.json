{
  "name": "inkspark",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, local-first writing app",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "spikes/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b && npm run typecheck:spikes",
    "typecheck:spikes": "node -e \"const fs=require('node:fs');const ws=fs.existsSync('spikes')?fs.readdirSync('spikes').filter(function(d){return fs.existsSync('spikes/'+d+'/package.json')}):[];if(ws.length){require('node:child_process').execSync('npm run typecheck --workspaces --if-present',{stdio:'inherit'})}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "bindings": "cargo run -p inkspark --bin export-bindings",
    "bindings:check": "cargo run -p inkspark --bin export-bindings -- --check",
    "spike:editor": "npm run test:browser -w @inkspark/spike-editor-text",
    "spike:foliate": "npm run test:browser -w @inkspark/spike-foliate-view",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "^10.1.0"
  }
}
