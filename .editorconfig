root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Generated by tauri-specta; never edit by hand.
[src/contracts/bindings.ts]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
